# Generated by `altevra service install --mirror-dir deploy/systemd/`.
# Re-generate after changing binary path or DB locations.
#
# Install with:
#   altevra service install --dry-run        # preview
#   altevra service install --apply          # write to ~/.config/systemd/user/
#   systemctl --user enable --now altevra-embedder.service
#
# Decision (R1): the embedder runs as a separate unit rather than a brain job
# because it hits an external embedding API with its own rate limit and needs
# independent restart behaviour. See crates/altevra-cli/src/commands/service.rs.

[Unit]
Description=Altevra Embedder Worker
Documentation=https://github.com/ceoimperiumprojects/altevra
After=network.target altevra-brain.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'test ! -f ${HOME}/.altevra/state/maintenance.lock || exit 0'
ExecStart=/usr/local/bin/altevra embed run \
    --db /home/USER/.altevra/altevra.db
Environment=HOME=/home/USER
WorkingDirectory=/home/USER
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=altevra-embedder

[Install]
WantedBy=default.target
