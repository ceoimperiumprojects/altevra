# Generated by `altevra service install --mirror-dir deploy/systemd/`.
# Re-generate after changing binary path or DB/vault locations.
#
# Install with:
#   altevra service install --dry-run        # preview
#   altevra service install --apply          # write to ~/.config/systemd/user/
#   systemctl --user enable --now altevra-brain.service
#   loginctl enable-linger $(whoami)

[Unit]
Description=Altevra Brain Daemon
Documentation=https://github.com/ceoimperiumprojects/altevra
After=network.target

[Service]
Type=simple
# Stale-lock TTL check: exit 0 (non-fatal) if maintenance.lock present.
# The lock is held during `altevra db unify`; services restart on clear.
ExecStartPre=/bin/sh -c 'test ! -f ${HOME}/.altevra/state/maintenance.lock || exit 0'
ExecStart=/usr/local/bin/altevra brain start \
    --db /home/USER/.altevra/altevra.db \
    --vault /home/USER/Obsidian/Imperium
Environment=HOME=/home/USER
WorkingDirectory=/home/USER
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=altevra-brain

[Install]
WantedBy=default.target
